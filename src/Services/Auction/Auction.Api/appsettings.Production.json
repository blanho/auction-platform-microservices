{
  "Logging": {
    "ServiceName": "AuctionService",
    "Environment": "production",
    "MinimumLevel": "Warning",
    "EnableConsole": true,
    "File": {
      "Enabled": false
    },
    "Elasticsearch": {
      "Enabled": true
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:8081",
        "Protocols": "Http2"
      }
    }
  },
  "Observability": {
    "ServiceName": "AuctionService",
    "Environment": "production",
    "EnableConsoleExporter": false
  }
}
